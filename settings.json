{
  "model": "sonnet",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/auto-sync.js --pull",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/auto-sync.js"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "image-preview@better-claude": true,
    "sub-meter@better-claude": true,
    "commit@better-claude": true,
    "superpowers@anthropic-plugin-directory": true,
    "claude-memory@anthropic-plugin-directory": true,
    "profile-sync@perfil-claude": true
  },
  "extraKnownMarketplaces": {
    "perfil-claude": {
      "source": {
        "source": "github",
        "repo": "VasquezRivero92/Perfil-Claude"
      }
    },
    "addy-agent-skills": {
      "source": {
        "source": "github",
        "repo": "addyosmani/agent-skills"
      }
    },
    "better-claude": {
      "source": {
        "source": "github",
        "repo": "midudev/better-claude"
      }
    }
  },
  "pluginConfigs": {
    "image-preview@better-claude": {
      "options": {
        "window": true
      }
    }
  },
  "autoUpdatesChannel": "latest",
  "theme": "dark",
  "autoCompactEnabled": true
}
